# ===== Report pricing — TEST MODE =====================================
# true  = every paid report is charged REPORTS_TEST_PRICE_INR (for end-to-end
#         JioPay + PDF-delivery testing). JioPay rejects amounts below ₹2.00
#         (error P1006), so ₹1 is not possible — the minimum test charge is ₹2.
# false = real prices (₹5000 / ₹4999 / ₹3999 / ₹1999 / ₹499 / ₹199 …).
# >>> SET REPORTS_TEST_PRICING=false BEFORE GOING LIVE so real customers are
# >>> charged the real prices, not ₹2.
# Reverted to real prices after the ₹2 test pass (2026-06-18). Flip to true only to re-test.
REPORTS_TEST_PRICING=false
REPORTS_TEST_PRICE_INR=2