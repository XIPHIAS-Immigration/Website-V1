<?xml version="1.0" encoding="utf-8"?>
<!--
  Use this as web.config in the physical root of any separate IIS site bound
  only to xiphiasimmigration.com. The main application web.config already
  contains the same redirect when both hostnames share one IIS site.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Redirect apex domain to canonical www domain" stopProcessing="true">
          <match url="(.*)" />
          <action
            type="Redirect"
            url="https://www.xiphiasimmigration.com/{R:1}"
            redirectType="Permanent"
            appendQueryString="true"
          />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
